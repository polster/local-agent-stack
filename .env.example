# Per-developer overrides. Copy to .env (gitignored) and adjust.

# Base tool and image pins
# OPENSHELL_VERSION=0.1.3
# OPENSHELL_BASE_IMAGE=nvcr.io/nvidia/base/ubuntu:24.04
# SANDBOX_IMAGE=local-agent-stack:opencode
# OPENCODE_VERSION=1.18.34
# MLX_SERVER_PKG=mlx-openai-server
# MLX_SERVER_VERSION=TODO
# MLX_TOOL_PYTHON=3.12

# Model (must exist in host/mlx/models.yaml)
# MODEL_ID=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit
# MODEL_ALIAS=local-coder
# TOOL_CALL_PARSER=qwen3_coder

# Networking
# MLX_PORT=8080
# MLX_HOST=auto
# MLX_BIND_ALL=1

# Optional runtime overrides used by scripts
# SANDBOX_NAME=local-agent
# PROFILE=readonly-review
# IMAGE_TAG=local-agent-stack:opencode
# BASE_IMAGE=nvcr.io/nvidia/base/ubuntu:24.04
# IMAGE=registry.internal/dev/agent-bmad:0.1.0
# STRICT_POLICY=1
