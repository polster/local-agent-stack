{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local",
      "options": {
        "baseURL": "{env:MLX_BASE_URL}",
        "apiKey": "local-no-key-needed"
      },
      "models": {
        "local-coder": {
          "name": "Qwen3 Coder 30B (local MLX)",
          "tools": true,
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "model": "mlx/local-coder",
  "autoupdate": false
}
